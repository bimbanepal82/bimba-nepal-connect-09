# Supabase Configuration
# Get these values from your Supabase project dashboard
# https://supabase.com/dashboard/project/{project-id}/settings/api

# Public API URL (safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Public Anonymous Key (safe to expose)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (NEVER commit this - server-side only)
# Set this in Cloudflare Workers via: wrangler secret put SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: API Base URL (usually not needed)
# SUPABASE_API_BASE_URL=https://your-project.supabase.co/rest/v1