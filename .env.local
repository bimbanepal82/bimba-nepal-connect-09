# Supabase Configuration for Local Development
# Get these values from your Supabase project dashboard
# https://supabase.com/dashboard/project/{project-id}/settings/api

# Public API URL - Replace with your actual Supabase URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Public Anonymous Key - Replace with your actual anon key
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Service Role Key (for server-side operations only)
# Set this in Cloudflare Workers via: wrangler secret put SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here
